#!/bin/sh
# After every commit, refresh the globally installed copies of agy-skill so
# local agents (Antigravity, Claude Code, Codex, OpenCode) pick up the change.
# Pushing is intentionally NOT done here: publish only after the owner approves
# (`npm run sync:push` or a manual `git push`).
REPO_ROOT="$(git rev-parse --show-toplevel)"
node "$REPO_ROOT/bin/cli.mjs" install --global
